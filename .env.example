# ==============================================================================
# Environment Configuration - Ayush Patient Case-Taking Software (SIH 2026)
# ==============================================================================

NODE_ENV=development
PORT=3000
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=generate-a-32-byte-hex-secret-with-openssl-rand-hex-32

# Database (PostgreSQL)
DATABASE_URL="postgresql://ayush_user:ayush_password@localhost:5432/ayush_db?schema=public"

# ABDM & Ayush Health Authority Sandbox credentials
ABDM_CLIENT_ID="your-abdm-client-id"
ABDM_CLIENT_SECRET="your-abdm-client-secret"
ABDM_GATEWAY_URL="https://dev.abdm.gov.in/gateway/v0.5"

# AI Service Configuration (OpenAI / Grok / Azure / Local Ollama)
AI_PROVIDER="openai" # openai | grok | azure | ollama
OPENAI_API_KEY="your-openai-or-grok-api-key"
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL_NAME="gpt-4o-mini"

# S3 & Object Storage (AWS S3 or Local MinIO)
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET_NAME="ayush-medical-records"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"

# Voice & OCR Settings
BHASHINI_API_KEY=""
BHASHINI_USER_ID=""
TESSERACT_LANG="eng+hin+mar"
