# ==============================================================================
# AyurSetu / MediMind AI — Production Environment Specification
# SIH 2026 Problem ID 26047 (Ministry of Ayush / AIIA)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE RUNTIME (Required in all environments)
# ------------------------------------------------------------------------------
NODE_ENV="production"
PORT="3000"

# ------------------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL DATABASE (Required - Server-Only)
# ------------------------------------------------------------------------------
# DATABASE_URL: Supabase Transaction Pooler URI (port 6543 with pgbouncer=true) for runtime queries
DATABASE_URL="postgresql://postgres.oxscufecwwnlaxhjbhxo:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Supabase Direct Session URI (port 5432) for running `prisma migrate deploy`
DIRECT_URL="postgresql://postgres.oxscufecwwnlaxhjbhxo:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 3. SUPABASE AUTH & STORAGE GATEWAY
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL: Public HTTPS endpoint (Client-Safe & Server)
NEXT_PUBLIC_SUPABASE_URL="https://oxscufecwwnlaxhjbhxo.supabase.co"

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Public anonymous key (Client-Safe & Server)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-anon-token"

# SUPABASE_SERVICE_ROLE_KEY: High-privilege management secret (Server-Only — NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-service-role-token"

# SUPABASE_STORAGE_BUCKET: Name of private medical documents storage bucket (Default: medical-documents)
SUPABASE_STORAGE_BUCKET="medical-documents"

# ------------------------------------------------------------------------------
# 4. FIELD-LEVEL DATA ENCRYPTION & SECURITY (Required - Server-Only)
# ------------------------------------------------------------------------------
# ENCRYPTION_SECRET_KEY: 64-hex character (256-bit) AES-256-GCM field encryption key
ENCRYPTION_SECRET_KEY="e4d2f8a19b3c4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f"

# ------------------------------------------------------------------------------
# 5. MULTIMODAL AI, OCR & SPEECH (Optional - Defaults to embedded open engines)
# ------------------------------------------------------------------------------
# OCR Engine (Default: embedded Tesseract.js / pdfjs)
OCR_PROVIDER="tesseract"
OCR_LANGS="eng+hin"
OCR_TIMEOUT_MS="45000"
OCR_PDF_PAGES="2"

# Cloud AI & Multilingual Speech (Optional)
VOICE_PROVIDER="web-speech"
OPENAI_API_KEY="sk-placeholder-for-whisper"
BHASHINI_API_KEY="placeholder-for-bhashini"

# ------------------------------------------------------------------------------
# 6. ABDM NATIONAL HEALTH AUTHORITY (NHA) GATEWAY (Optional Sandbox)
# ------------------------------------------------------------------------------
ABDM_GATEWAY_URL="https://dev.abdm.gov.in/gateway/v0.5"
ABDM_CLIENT_ID="sbx-aiia-case-taking-01"
ABDM_CLIENT_SECRET="sbx-secret-key-placeholder"
