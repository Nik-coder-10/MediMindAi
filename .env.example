# ==============================================================================
# AyurSetu / MediMind AI Environment Configuration
# SIH 2026 Problem ID 26047 (Ministry of Ayush / AIIA)
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database Connection (Supabase / Managed Postgres)
# DATABASE_URL: Transaction pooled connection (port 6543) for runtime queries
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: Direct session connection (port 5432) for Prisma migrations
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"


# NextAuth Authentication & Session Security
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="sih-2026-ayursetu-production-jwt-super-secret-key-32b"

# AES-256-GCM Application-Level Field Encryption Key (64 hex characters / 256 bits)
ENCRYPTION_SECRET_KEY="e4d2f8a19b3c4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f"

# MinIO / AWS S3 Medical Document Object Store
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin123"
S3_BUCKET_NAME="medical-prescriptions"
S3_REGION="ap-south-1"

# Multilingual AI Voice Providers (Whisper / Bhashini / Azure)
VOICE_PROVIDER="web-speech" # Options: 'whisper' | 'bhashini' | 'azure' | 'web-speech'
OPENAI_API_KEY="sk-placeholder-for-whisper"
BHASHINI_API_KEY="placeholder-for-bhashini"

# OCR Provider Configuration
OCR_PROVIDER="tesseract" # Options: 'tesseract' | 'azure-form-recognizer' | 'google-document-ai'

# ABDM National Health Authority (NHA) Sandbox Gateway
ABDM_CLIENT_ID="sbx-aiia-case-taking-01"
ABDM_CLIENT_SECRET="sbx-secret-key-placeholder"
ABDM_SANDBOX_URL="https://dev.abdm.gov.in/gateway/v0.5"
