datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


generator client {
  provider = "prisma-client-js"
}

// ==============================================================================
// ENUMS
// ==============================================================================

/// System user authorization and Ayush care team roles
enum Role {
  PATIENT
  DOCTOR
  ADMIN
  NURSE
}

/// Biological & demographic gender
enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

/// Clinical encounter lifecycle statuses
enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  WAITING_FOR_DOCTOR
  COMPLETED
  CANCELLED
}

/// Clinical triage urgency level
enum TriagePriority {
  ROUTINE
  URGENT
  EMERGENCY
}

/// Role of participant in conversation stream
enum TurnRole {
  PATIENT
  AI
  DOCTOR
  SYSTEM
}

/// Safety triage severity
enum RedFlagSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Categories of ingested medical records
enum DocumentType {
  PRESCRIPTION
  LAB
  DISCHARGE
  IMAGING
  OTHER
}

/// Granular extracted clinical entities from multimodal OCR / NER
enum EntityType {
  MEDICATION
  DIAGNOSIS
  LAB
  PROCEDURE
  ALLERGY
  VITAL
  AYUSH_FORMULATION
}

/// Question input types for adaptive engine
enum QuestionType {
  TEXT
  SINGLE_CHOICE
  MULTI_CHOICE
  SCALE
  YES_NO
}

/// Summary workflow review states
enum SummaryStatus {
  DRAFT
  ACCEPTED
  REJECTED
  REVISED
}

/// Ayurvedic Dosha dominance categories
enum DoshaDominance {
  VATA
  PITTA
  KAPHA
  VATA_PITTA
  PITTA_KAPHA
  VATA_KAPHA
  SAMADOSHA
}

/// Status of Ayushman Bharat Health Account verification
enum AbhaStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
  DEACTIVATED
}

/// Clinical observation category taxonomy (SOCRATES, AYUSH, Homeopathy, Document, Lifestyle)
enum ObservationType {
  SYMPTOM
  SIGN
  VITAL
  HISTORY
  MEDICATION
  ALLERGY
  LIFESTYLE
  DIET
  SLEEP
  MENTAL_WELLBEING
  AYURVEDA_PRAKRITI
  AYURVEDA_AGNI
  AYURVEDA_AMA
  AYURVEDA_DOSHA
  HOMEOPATHY_GENERAL
  HOMEOPATHY_MIASM
  HOMEOPATHY_MODALITY
  DOCUMENT_EXTRACTED
  PATIENT_REPORTED
  DOCTOR_RECORDED
}

/// Provenance source of clinical observation data
enum ObservationSource {
  PATIENT_INPUT
  DOCTOR_INPUT
  OCR_EXTRACTED
  VOICE_TRANSCRIPT
  QUESTION_RESPONSE
  DOCUMENT
  SYSTEM_INFERENCE
  IMPORTED_RECORD
}

/// Lifecycle state of a clinical observation
enum ObservationStatus {
  PRELIMINARY
  RECORDED
  VERIFIED
  REFUTED
  AMENDED
}

/// System-generated clinical insight status
enum InsightStatus {
  DRAFT
  REVIEW_REQUIRED
  VERIFIED
  REJECTED
  OVERRIDDEN
}

/// Attending doctor verification action
enum DoctorReviewDecision {
  CONFIRMED
  MODIFIED
  REJECTED
  OVERRIDDEN
}

/// Clinical knowledge domain taxonomy
enum KnowledgeConceptDomain {
  AYURVEDA
  HOMEOPATHY
  SHARED_CLINICAL
}

/// Concept category classification within knowledge graph
enum KnowledgeConceptCategory {
  SYMPTOM
  SIGN
  DOSHA
  GUNA
  PRAKRITI
  VIKRITI
  AGNI
  AMA
  DHATU
  SROTAS
  HERB
  FORMULATION
  MODALITY
  MIASM
  CONSTITUTION
  OTHER
}

/// Semantic relationship type between knowledge graph concepts
enum KnowledgeRelationshipType {
  ASSOCIATED_WITH
  CHARACTERISTIC_OF
  HAS_MODALITY
  RELIEVED_BY
  AGGRAVATED_BY
  RELATED_TO
  SUBTYPE_OF
  PART_OF
  CONTRASTS_WITH
  SUPPORTS
  INCONSISTENT_WITH
  DERIVED_FROM
  EQUIVALENT_TO
}

/// Lifecycle status for versioned knowledge concepts, packs, and relationships
enum KnowledgeStatus {
  DRAFT
  ACTIVE
  DEPRECATED
  RETIRED
}

// ==============================================================================
// 1. CORE IDENTITY & USER MANAGEMENT
// ==============================================================================

model User {
  id                String    @id @default(uuid()) @db.Uuid
  supabaseUserId    String?   @unique
  role              Role      @default(PATIENT)
  abhaId            String?   @unique
  phone             String?   @unique
  email             String?   @unique
  passwordHash      String?
  preferredLanguage String    @default("en")
  isActive          Boolean   @default(true)
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  patientProfile    PatientProfile?
  doctorProfile     DoctorProfile?
  auditLogs         AuditLog[]

  @@index([supabaseUserId])
  @@index([role])
  @@index([abhaId])
  @@index([phone])
  @@index([email])
  @@map("users")
}


model PatientProfile {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @unique @db.Uuid
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  firstName           String
  lastName            String
  dateOfBirth         DateTime
  gender              Gender
  bloodGroup          String?
  address             String?
  emergencyContact    Json?           @db.JsonB
  baselinePrakriti    DoshaDominance?
  medicalHistory      Json?           @db.JsonB
  
  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  clinicalSessions    ClinicalSession[]
  consentRecords      ConsentRecord[]
  timelineEvents      MedicalTimelineEvent[]
  clinicalObservations ClinicalObservation[]
  clinicalInsights    ClinicalInsight[]
  abhaLink            AbhaLink?
  fhirResources       FhirResource[]

  @@index([userId])
  @@index([baselinePrakriti])
  @@map("patient_profiles")
}

model DoctorProfile {
  id                  String          @id @default(uuid()) @db.Uuid
  userId              String          @unique @db.Uuid
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  registrationNumber  String          @unique
  qualification       String
  specialization      String
  department          String?
  hospitalAffiliation String?
  isActive            Boolean         @default(true)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  clinicalSessions    ClinicalSession[]
  verifiedObservations ClinicalObservation[]
  reviewedInsights    ClinicalInsight[]

  @@index([userId])
  @@index([registrationNumber])
  @@map("doctor_profiles")
}

// ==============================================================================
// 2. ABDM CONSENT & REGULATORY GOVERNANCE
// ==============================================================================

model ConsentRecord {
  id                String    @id @default(uuid()) @db.Uuid
  patientId         String    @db.Uuid
  patient           PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)

  purpose           String
  language          String    @default("hi")
  audioConsentUrl   String?
  grantedAt         DateTime  @default(now())
  revokedAt         DateTime?
  expiryDate        DateTime?
  version           String    @default("1.0")
  ipAddress         String?
  userAgent         String?
  metadata          Json?     @db.JsonB

  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([patientId])
  @@index([grantedAt])
  @@index([revokedAt])
  @@map("consent_records")
}

// ==============================================================================
// 3. CLINICAL SESSION & ADAPTIVE ENGINE STATE MACHINE
// ==============================================================================

model ClinicalSession {
  id                  String          @id @default(uuid()) @db.Uuid
  patientId           String          @db.Uuid
  patient             PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId            String?         @db.Uuid
  doctor              DoctorProfile?  @relation(fields: [doctorId], references: [id], onDelete: SetNull)

  status              SessionStatus   @default(IN_PROGRESS)
  language            String          @default("hi")
  triagePriority      TriagePriority  @default(ROUTINE)
  startedAt           DateTime        @default(now())
  completedAt         DateTime?
  redFlagTriggered    Boolean         @default(false)
  notes               String?         @db.Text

  deletedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  // Engine & conversation relations
  conversationTurns   ConversationTurn[]
  chiefComplaints     ChiefComplaint[]
  adaptiveAnswers     AdaptiveAnswer[]
  patientAnswers      PatientAnswer[]
  engineState         EngineState?
  redFlagEvents       RedFlagEvent[]
  medicalDocuments    MedicalDocument[]
  clinicalSummary     ClinicalSummary?
  ayurvedaAssessment  AyurvedaAssessment?
  clinicalObservations ClinicalObservation[]
  clinicalInsights    ClinicalInsight[]
  fhirResources       FhirResource[]

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([triagePriority])
  @@index([redFlagTriggered])
  @@map("clinical_sessions")
}

/// Adaptive Question Engine live state snapshot per session
model EngineState {
  id                  String          @id @default(uuid()) @db.Uuid
  sessionId           String          @unique @db.Uuid
  session             ClinicalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  category            String          // CHEST_PAIN, HEADACHE, ABDOMINAL_PAIN, JOINT_PAIN, FEVER, GENERAL
  currentNodeId       String?         // ID of the next pending question node
  collectedFacts      Json            @default("{}") @db.JsonB // Structured facts (SOCRATES: site, onset, character, etc.)
  questionHistory     Json            @default("[]") @db.JsonB // List of node IDs asked
  questionCount       Int             @default(0)
  maxQuestions        Int             @default(12)
  triageLevel         TriagePriority  @default(ROUTINE)
  isPaused            Boolean         @default(false)
  completed           Boolean         @default(false)

  updatedAt           DateTime        @updatedAt
  createdAt           DateTime        @default(now())

  @@index([sessionId])
  @@index([category])
  @@map("engine_states")
}

/// Standalone declarative Question Node for the clinical decision tree
model QuestionNode {
  id                  String          @id @default(uuid()) @db.Uuid
  chiefComplaintCategory String       // CHEST_PAIN, HEADACHE, etc.
  nodeCode            String          @unique // e.g. CP_SEVERITY, CP_RADIATION, HA_ONSET
  questionText        String          @db.Text
  questionTextHindi   String          @db.Text
  questionType        QuestionType    @default(SINGLE_CHOICE)
  options             Json?           @db.JsonB // Array of { value, labelHi, labelEn, score, metadata }
  redFlagTriggers     Json?           @db.JsonB // Criteria triggering safety alert
  nextNodeLogic       Json?           @db.JsonB // Conditional rules: { "ifValue": "severe", "goTo": "CP_EMERGENCY" }
  clinicalDomain      String?         // SOCRATES_SEVERITY, AGNI, AMA, PRAKRITI, etc.

  createdAt           DateTime        @default(now())
  patientAnswers      PatientAnswer[]

  @@index([chiefComplaintCategory])
  @@index([nodeCode])
  @@map("question_nodes")
}

/// Structured patient response to a specific QuestionNode
model PatientAnswer {
  id                  String          @id @default(uuid()) @db.Uuid
  sessionId           String          @db.Uuid
  session             ClinicalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionNodeId      String?         @db.Uuid
  questionNode        QuestionNode?   @relation(fields: [questionNodeId], references: [id], onDelete: SetNull)

  nodeCode            String          // Denormalized code for quick reference
  answerValue         Json            @db.JsonB // Structured answer payload { raw, value, confidence, isSkipped }
  answeredAt          DateTime        @default(now())

  @@index([sessionId])
  @@index([questionNodeId])
  @@index([nodeCode])
  @@map("patient_answers")
}

model ConversationTurn {
  id                String          @id @default(uuid()) @db.Uuid
  sessionId         String          @db.Uuid
  session           ClinicalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role              TurnRole
  contentText       String          @db.Text
  contentAudioUrl   String?
  timestamp         DateTime        @default(now())
  metadata          Json?           @db.JsonB

  @@index([sessionId])
  @@index([timestamp])
  @@map("conversation_turns")
}

model ChiefComplaint {
  id                String          @id @default(uuid()) @db.Uuid
  sessionId         String          @db.Uuid
  session           ClinicalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  symptomName       String
  duration          String
  severity          String
  location          String?
  aggravatingFactors String?
  relievingFactors  String?
  metadata          Json?           @db.JsonB

  createdAt         DateTime        @default(now())

  @@index([sessionId])
  @@map("chief_complaints")
}

model AdaptiveAnswer {
  id                String          @id @default(uuid()) @db.Uuid
  sessionId         String          @db.Uuid
  session           ClinicalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questionId        String
  questionText      String          @db.Text
  answerText        String          @db.Text
  answerAudioUrl    String?
  clinicalContext   String?
  confidence        Float?
  metadata          Json?           @db.JsonB

  createdAt         DateTime        @default(now())

  @@index([sessionId])
  @@index([questionId])
  @@map("adaptive_answers")
}

// ==============================================================================
// 4. SAFETY & RED FLAG MONITORING
// ==============================================================================

model RedFlagEvent {
  id                String          @id @default(uuid()) @db.Uuid
  sessionId         String          @db.Uuid
  session           ClinicalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  ruleId            String
  description       String          @db.Text
  severity          RedFlagSeverity @default(HIGH)
  triggeredAt       DateTime        @default(now())
  notified          Boolean         @default(false)
  notifiedAt        DateTime?
  actionTaken       String?         @db.Text

  @@index([sessionId])
  @@index([severity])
  @@index([notified])
  @@map("red_flag_events")
}

// ==============================================================================
// 5. MULTIMODAL MEDICAL DOCUMENTS & OCR EXTRACTION
// ==============================================================================

model MedicalDocument {
  id                String          @id @default(uuid()) @db.Uuid
  sessionId         String          @db.Uuid
  session           ClinicalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type              DocumentType    @default(PRESCRIPTION)
  originalFileUrl   String
  fileName          String
  mimeType          String
  fileSize          Int
  ocrRawText        String?         @db.Text
  language          String?         @default("en")
  uploadedAt        DateTime        @default(now())
  deletedAt         DateTime?

  extractedEntities ExtractedMedicalEntity[]
  timelineEvents    MedicalTimelineEvent[]

  @@index([sessionId])
  @@index([type])
  @@map("medical_documents")
}

model ExtractedMedicalEntity {
  id                String          @id @default(uuid()) @db.Uuid
  documentId        String          @db.Uuid
  document          MedicalDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  type              EntityType
  rawText           String
  structuredData    Json            @db.JsonB
  confidence        Float           @default(1.0)
  isVerifiedByDoctor Boolean        @default(false)

  createdAt         DateTime        @default(now())

  @@index([documentId])
  @@index([type])
  @@map("extracted_medical_entities")
}

model MedicalTimelineEvent {
  id                String          @id @default(uuid()) @db.Uuid
  patientId         String          @db.Uuid
  patient           PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sourceDocumentId  String?         @db.Uuid
  sourceDocument    MedicalDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)

  eventDate         DateTime
  title             String
  description       String?         @db.Text
  category          String
  metadata          Json?           @db.JsonB

  createdAt         DateTime        @default(now())

  @@index([patientId])
  @@index([eventDate])
  @@map("medical_timeline_events")
}

// ==============================================================================
// 6. CLINICAL SUMMARY & NOTES
// ==============================================================================

model ClinicalSummary {
  id                    String          @id @default(uuid()) @db.Uuid
  sessionId             String          @unique @db.Uuid
  session               ClinicalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  aiGeneratedMarkdown   String          @db.Text
  doctorEditedMarkdown  String?         @db.Text
  status                SummaryStatus   @default(DRAFT)
  version               Int             @default(1)
  reviewedAt            DateTime?

  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([sessionId])
  @@index([status])
  @@map("clinical_summaries")
}

// ==============================================================================
// 7. AYUSH ASSESSMENT (CHARAKA SAMHITA CLINICAL MODEL)
// ==============================================================================

model AyurvedaAssessment {
  id                  String          @id @default(uuid()) @db.Uuid
  sessionId           String          @unique @db.Uuid
  session             ClinicalSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  prakriti            DoshaDominance
  vikriti             DoshaDominance
  dushya              String?
  desha               String?
  bala                String?
  kala                String?
  anala               String?
  sara                String?
  samhanana           String?
  pramana             String?
  satmya              String?
  sattva              String?
  aharaShakti         String?
  vyayamaShakti       String?
  vaya                String?

  ashtavidhaData      Json?           @db.JsonB
  aharaVihara         Json?           @db.JsonB
  notes               String?         @db.Text

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([sessionId])
  @@index([prakriti])
  @@index([vikriti])
  @@map("ayurveda_assessments")
}

// ==============================================================================
// 8. AUDIT TRAILS & COMPLIANCE
// ==============================================================================

model AuditLog {
  id                String    @id @default(uuid()) @db.Uuid
  actorId           String?   @db.Uuid
  actor             User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  action            String
  resourceType      String
  resourceId        String?   @db.Uuid
  ipAddress         String?
  metadata          Json?     @db.JsonB
  timestamp         DateTime  @default(now())

  @@index([actorId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

// ==============================================================================
// 9. ABDM & FHIR INTEROPERABILITY
// ==============================================================================

model AbhaLink {
  id                String          @id @default(uuid()) @db.Uuid
  patientId         String          @unique @db.Uuid
  patient           PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  abhaNumber        String          @unique
  abhaAddress       String          @unique
  status            AbhaStatus      @default(ACTIVE)
  kycVerified       Boolean         @default(true)
  linkedAt          DateTime        @default(now())
  metadata          Json?           @db.JsonB

  @@index([patientId])
  @@index([abhaNumber])
  @@index([abhaAddress])
  @@map("abha_links")
}

model FhirResource {
  id                String          @id @default(uuid()) @db.Uuid
  patientId         String          @db.Uuid
  patient           PatientProfile  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessionId         String?         @db.Uuid
  session           ClinicalSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  resourceType      String
  resourceJson      Json            @db.JsonB
  versionId         String          @default("1")
  lastUpdated       DateTime        @default(now())

  @@index([patientId])
  @@index([sessionId])
  @@index([resourceType])
  @@map("fhir_resources")
}

// ==============================================================================
// 10. STRUCTURED CLINICAL OBSERVATIONS, EVIDENCE & EXPLAINABLE INSIGHTS
// ==============================================================================

/// Discrete, queryable clinical observation with temporal semantics and full provenance
model ClinicalObservation {
  id                    String              @id @default(uuid()) @db.Uuid
  patientId             String              @db.Uuid
  patient               PatientProfile      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessionId             String              @db.Uuid
  session               ClinicalSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  category              ObservationType     @default(SYMPTOM)
  code                  String              // Standardized concept code e.g. "symptom.burning_sensation", "agni.manda", "miasm.psora"
  name                  String              // Human readable label e.g. "Burning sensation in epigastrium"
  
  // Structured observation facets
  value                 String?             // Primary qualitative or quantitative value
  numericValue          Float?              // For numeric measurements (severity 1-10, BP, SpO2, glucose)
  unit                  String?             // e.g. "/10", "mmHg", "mg/dL", "days"
  bodySite              String?             // Anatomical location (e.g. "Epigastric", "Bilateral knees")
  laterality            String?             // "LEFT", "RIGHT", "BILATERAL", "UNILATERAL"
  severity              String?             // "MILD", "MODERATE", "SEVERE"
  duration              String?             // Duration string (e.g. "3 weeks", "2 days")
  frequency             String?             // "DAILY", "CONSTANT", "INTERMITTENT", "POSTPRANDIAL"
  modality              String?             // Aggravating / Relieving factors ("Worse at night", "Better with warm water")
  rawText               String              @db.Text // Exact original text/transcript provided by patient or doctor
  
  status                ObservationStatus   @default(RECORDED)
  source                ObservationSource   @default(PATIENT_INPUT)
  confidence            Float               @default(1.0) // Confidence score [0.0 - 1.0]

  // Temporal information
  observedAt            DateTime?           // When the patient experienced the symptom
  reportedAt            DateTime            @default(now()) // When reported by patient/user
  recordedAt            DateTime            @default(now()) // When persisted in system
  verifiedAt            DateTime?           // When doctor verified/reviewed
  
  // Provenance & Source linkage
  sourceQuestionNodeId  String?             // Question node code if derived from adaptive engine
  sourceDocumentId      String?             // Medical document ID if derived from OCR
  sourceEntityId        String?             // Extracted entity ID
  
  // Verification details
  verifiedById          String?             @db.Uuid
  verifiedBy            DoctorProfile?      @relation(fields: [verifiedById], references: [id], onDelete: SetNull)
  doctorNotes           String?             @db.Text
  
  // Dynamic structured metadata (extensible for specific AYUSH or Homeopathy facets)
  metadata              Json?               @db.JsonB

  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  // Relationships to Explainable Evidence & Knowledge Links
  evidenceItems         ClinicalEvidence[]
  knowledgeLinks        ObservationKnowledgeLink[]

  @@index([patientId])
  @@index([sessionId])
  @@index([category])
  @@index([code])
  @@index([status])
  @@index([reportedAt])
  @@index([observedAt])
  @@index([verifiedById])
  @@map("clinical_observations")
}

/// Links specific observations to a system insight as supporting or contradictory evidence
model ClinicalEvidence {
  id                    String              @id @default(uuid()) @db.Uuid
  insightId             String              @db.Uuid
  insight               ClinicalInsight     @relation(fields: [insightId], references: [id], onDelete: Cascade)
  observationId         String              @db.Uuid
  observation           ClinicalObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  relationship          String              @default("SUPPORTING") // "SUPPORTING" | "CONTRADICTORY" | "NEUTRAL"
  weight                Float               @default(1.0)          // Relative evidential weight [0.0 - 1.0]
  rationale             String?             @db.Text               // Natural language explanation of why this evidence matters

  createdAt             DateTime            @default(now())

  @@unique([insightId, observationId])
  @@index([insightId])
  @@index([observationId])
  @@index([relationship])
  @@map("clinical_evidence")
}

/// Explainable clinical assessment / pattern generated by AI or rules, subject to doctor review
model ClinicalInsight {
  id                    String                @id @default(uuid()) @db.Uuid
  patientId             String                @db.Uuid
  patient               PatientProfile        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sessionId             String                @db.Uuid
  session               ClinicalSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  insightType           String                // "AYURVEDA_DOSHA_PATTERN", "HOMEOPATHY_TOTALITY", "SAFETY_RISK", "TRIAGE_ESCALATION"
  title                 String                // e.g. "Predominant Pitta-Vata Aggravation Pattern"
  description           String                @db.Text
  
  status                InsightStatus         @default(DRAFT)
  confidence            Float                 @default(0.85) // Model confidence score [0.0 - 1.0]
  ruleOrModelVersion    String                @default("v1.0") // Provenance of the generating engine/rule
  
  // Doctor in the loop review & override
  reviewedById          String?               @db.Uuid
  reviewedBy            DoctorProfile?        @relation(fields: [reviewedById], references: [id], onDelete: SetNull)
  doctorDecision        DoctorReviewDecision?
  doctorOverrideText    String?               @db.Text
  doctorReviewReason    String?               @db.Text
  reviewedAt            DateTime?
  
  fingerprint           String                @default("") // Deterministic idempotency fingerprint
  metadata              Json?                 @db.JsonB
  generatedAt           DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  // Supporting & contradictory evidence links
  evidence              ClinicalEvidence[]

  @@unique([sessionId, fingerprint])
  @@index([patientId])
  @@index([sessionId])
  @@index([fingerprint])
  @@index([insightType])
  @@index([status])
  @@index([reviewedById])
  @@index([generatedAt])
  @@map("clinical_insights")
}

// ==============================================================================
// 11. AYUSH CLINICAL KNOWLEDGE GRAPH & EVIDENCE LAYER
// ==============================================================================

/// Curated knowledge source / bibliographic reference for AYUSH and clinical assertions
model KnowledgeSource {
  id                    String              @id @default(uuid()) @db.Uuid
  sourceKey             String              @unique // e.g. "CHARAKA_SAMHITA_SUTRA", "ORGANON_MEDICINE", "ICMR_CLINICAL_STANDARDS"
  title                 String              // Full title of traditional text or standard
  publisher             String?             // e.g. "Central Council for Research in Ayurvedic Sciences (CCRAS)"
  sourceType            String              // "TRADITIONAL_TEXT", "PHARMACOPOEIA", "CLINICAL_GUIDELINE", "STANDARDIZED_ONTOLOGY"
  citation              String?             @db.Text
  version               String              @default("v1.0")
  language              String              @default("sa")
  status                KnowledgeStatus     @default(ACTIVE)
  
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  knowledgePacks        KnowledgePack[]
  concepts              KnowledgeConcept[]
  relationships         KnowledgeRelationship[]

  @@index([sourceKey])
  @@index([status])
  @@map("knowledge_sources")
}

/// Versioned bundle of curated concepts and relationships
model KnowledgePack {
  id                    String                  @id @default(uuid()) @db.Uuid
  packKey               String                  @unique // e.g. "AYURVEDA_CORE_PACK_V1", "HOMEOPATHY_CORE_PACK_V1"
  name                  String
  domain                KnowledgeConceptDomain  @default(AYURVEDA)
  version               String                  @default("v1.0")
  description           String?                 @db.Text
  status                KnowledgeStatus         @default(ACTIVE)

  sourceId              String?                 @db.Uuid
  source                KnowledgeSource?        @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  concepts              KnowledgeConcept[]
  relationships         KnowledgeRelationship[]

  @@index([packKey])
  @@index([domain])
  @@index([status])
  @@map("knowledge_packs")
}

/// Curated AYUSH / Clinical Concept node in the Knowledge Graph
model KnowledgeConcept {
  id                    String                    @id @default(uuid()) @db.Uuid
  conceptKey            String                    @unique // e.g. "concept.dosha.pitta", "concept.symptom.burning_sensation"
  name                  String                    // Label in English / Romanized Sanskrit (e.g. "Pitta Dosha", "Daha / Burning")
  nameHindi             String?                   // Label in Devanagari (e.g. "पित्त दोष", "दाह / जलन")
  nameSanskrit          String?                   // Sanskrit transliteration
  normalizedName        String                    // Lowercase indexable string
  description           String                    @db.Text
  
  domain                KnowledgeConceptDomain    @default(AYURVEDA)
  category              KnowledgeConceptCategory  @default(OTHER)
  status                KnowledgeStatus           @default(ACTIVE)
  version               String                    @default("v1.0")

  packId                String?                   @db.Uuid
  pack                  KnowledgePack?            @relation(fields: [packId], references: [id], onDelete: SetNull)

  sourceId              String?                   @db.Uuid
  source                KnowledgeSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceReference       String?                   // Chapter/Verse citation e.g. "Charaka Sutrasthana 12/11"

  metadata              Json?                     @db.JsonB
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  // Graph Edges
  outgoingRelationships KnowledgeRelationship[]   @relation("SourceConcept")
  incomingRelationships KnowledgeRelationship[]   @relation("TargetConcept")

  // Observation links
  observationLinks      ObservationKnowledgeLink[]

  @@index([conceptKey])
  @@index([normalizedName])
  @@index([domain])
  @@index([category])
  @@index([status])
  @@map("knowledge_concepts")
}

/// Typed, directed semantic relationship edge between knowledge concepts
model KnowledgeRelationship {
  id                    String                    @id @default(uuid()) @db.Uuid
  sourceConceptId       String                    @db.Uuid
  sourceConcept         KnowledgeConcept          @relation("SourceConcept", fields: [sourceConceptId], references: [id], onDelete: Cascade)
  
  targetConceptId       String                    @db.Uuid
  targetConcept         KnowledgeConcept          @relation("TargetConcept", fields: [targetConceptId], references: [id], onDelete: Cascade)

  relationshipType      KnowledgeRelationshipType @default(ASSOCIATED_WITH)
  clinicalRationale     String?                   @db.Text
  weight                Float                     @default(1.0) // Relative confidence / relevance weight [0.0 - 1.0]
  status                KnowledgeStatus           @default(ACTIVE)
  version               String                    @default("v1.0")

  packId                String?                   @db.Uuid
  pack                  KnowledgePack?            @relation(fields: [packId], references: [id], onDelete: SetNull)

  sourceId              String?                   @db.Uuid
  source                KnowledgeSource?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceReference       String?                   // Textual citation e.g. "Ashtanga Hridaya Sutrasthana 1/7"

  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([sourceConceptId, targetConceptId, relationshipType, version])
  @@index([sourceConceptId])
  @@index([targetConceptId])
  @@index([relationshipType])
  @@index([status])
  @@map("knowledge_relationships")
}

/// Link mapping a patient's discrete ClinicalObservation to an established KnowledgeConcept
model ObservationKnowledgeLink {
  id                    String              @id @default(uuid()) @db.Uuid
  observationId         String              @db.Uuid
  observation           ClinicalObservation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  conceptId             String              @db.Uuid
  concept               KnowledgeConcept    @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  resolutionMethod      String              @default("DETERMINISTIC_KEY_MATCH") // "DETERMINISTIC_KEY_MATCH", "SYNONYM_RESOLVED", "DOCTOR_LINKED"
  confidence            Float               @default(1.0)
  knowledgeVersion      String              @default("v1.0")

  createdAt             DateTime            @default(now())

  @@unique([observationId, conceptId])
  @@index([observationId])
  @@index([conceptId])
  @@map("observation_knowledge_links")
}
